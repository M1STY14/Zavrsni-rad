# Install:  sudo cp deploy/merkle.service /etc/systemd/system/merkle.service
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now merkle
#
# Adjust User, paths, and ExecStart (run `which node`) to match your box.

[Unit]
Description=Merkle Tree Visualizer (Node/Express)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/merkle_visualizer/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=4000
Environment=CORS_ORIGINS=https://mtv.leokocijan.dev

# CAX11 = 2 vCPU / 4 GB. Cap at 1.5 cores / 3 GB so the Laravel portfolio,
# nginx, and the OS keep their headroom even if /api/git gets hammered.
CPUQuota=150%
MemoryMax=3G

# Light hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
